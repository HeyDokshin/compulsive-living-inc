// What Тоша, the red panda at the stall, says. One line per topic is picked at random.
// {name}, {price}, {bells} are filled in by the shop plugin.
{
  entries: [
    { id: 'shop:greet_first', lines: ['Привет-привет! Я Тоша, у меня тут лавка. Каждое утро привожу что-нибудь новенькое — заглядывай!'] },
    { id: 'shop:greet', lines: [
      'О, покупатель! Смотри, что сегодня привезла.',
      'Привет! Сегодня на полках кое-что интересное.',
      'Заходи-заходи! Колокольчики любят движение.',
      'Утро доброе — или уже не утро? Всё равно добро пожаловать!',
    ] },
    { id: 'shop:browse', lines: ['Выбирай, не торопись.', 'Всё свежее, всё сегодняшнее!'] },
    { id: 'shop:thanks', lines: ['«{name}» — отличный выбор!', 'Держи! «{name}» тебе точно пригодится.', 'Спасибо за покупку! Приходи ещё.'] },
    { id: 'shop:poor', lines: ['Ой, не хватает колокольчиков. «{name}» стоит {price}, а у тебя {bells}.', 'Колокольчиков маловато… Может, продашь что-нибудь в ящик?'] },
    { id: 'shop:full', lines: ['Карманы-то полные! Освободи местечко.'] },
    { id: 'shop:sold_out', lines: ['Это на сегодня закончилось. Завтра привезу что-то другое!'] },
    { id: 'shop:market', lines: ['Слушай, что говорят на рынке.', 'Я тут кое-что слышала про цены!'] },
    { id: 'shop:bye', lines: ['Пока-пока!', 'Заходи завтра — будет новое!', 'Удачи на острове!'] },
  ],
}
