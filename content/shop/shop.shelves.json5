    { id: 'shop:plants', name: 'Саженцы', tag: '#nature:saplings', count: 2, stock: 3, markup: 2, order: 30 },
    { id: 'shop:seeds', name: 'Семена', tag: '#garden:seeds', count: 0, stock: 0, markup: 1, order: 40 },
