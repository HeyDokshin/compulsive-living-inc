// What villagers say. Each entry: a topic, optional conditions, a few lines (one is picked).
// A line may start with a face tag — [joy] [happy] [sad] [worried] [angry] [surprised] [sleepy] [love] [shy]
// [thinking] [wink] [neutral]: the speaker's face shows it (untagged lines are read by their words).
// A line for the villager's own personality beats a general one; among those, the most specific
// conditions win. Placeholders: {name} {phrase} {animal} {player} {other} {item} {request} {hearts}
// {fancy} (their favourite or pet hate) {level} (what the friendship is called, in letters);
// {a} — the villager's own ending ("рад{a}" → рад / рада).
//   when: { hours: [from, to), weather: rain | dry, minHearts, maxHearts, seasons: [...] }
{
  entries: [
    // --- meeting ------------------------------------------------------------------------------
    { id: 'villagers:hello', topic: 'hello', lines: [
      'Привет! Я {name}, {animal}. Теперь мы соседи, {phrase}!',
      'Ой, здравствуй! Меня зовут {name}. Я только что переехал{a} — {phrase}!',
    ] },

    // --- greetings ----------------------------------------------------------------------------
    { id: 'villagers:greet', topic: 'greet', lines: ['Привет, {player}! {phrase}!', 'О, это ты! Как дела, {phrase}?', 'Здравствуй-здравствуй, {phrase}!'] },
    { id: 'villagers:greet_morning', topic: 'greet', when: { hours: [5, 11] }, lines: ['Доброе утро, {player}! Уже на ногах, {phrase}?', 'Утро — моё любимое время, {phrase}!'] },
    { id: 'villagers:greet_evening', topic: 'greet', when: { hours: [18, 23] }, lines: ['Добрый вечер, {phrase}! Скоро звёзды.', 'Вечер такой тихий… {phrase}.'] },
    { id: 'villagers:greet_rain', topic: 'greet', when: { weather: 'rain' }, lines: ['Ну и ливень, {phrase}! Цветам-то хорошо.', '[happy] Люблю дождь: шуршит, как сказка, {phrase}.'] },
    { id: 'villagers:greet_friend', topic: 'greet', when: { minHearts: 3 }, lines: ['{player}! Я так рад{a} тебя видеть, {phrase}!', 'А я как раз о тебе думал{a}, {phrase}!'] },
    { id: 'villagers:greet_grumpy', topic: 'greet', personality: 'villagers:grumpy', when: { maxHearts: 2 }, lines: ['[angry] Хм. Ты опять. {phrase}.', '[angry] Чего тебе, {phrase}?'] },
    { id: 'villagers:greet_sporty', topic: 'greet', personality: 'villagers:sporty', lines: ['Йо, {player}! Разминаешься? {phrase}!', 'Пять кругов по острову — и я как новенький, {phrase}!'] },
    { id: 'villagers:greet_elegant', topic: 'greet', personality: 'villagers:elegant', lines: ['[happy] Ах, {player}, ты сегодня мило выглядишь, {phrase}.', '[wink] Здравствуй, дорогуша, {phrase}.'] },
    { id: 'villagers:greet_sleepy', topic: 'greet', personality: 'villagers:sleepy', lines: ['[sleepy] Приве-е-ет… {phrase}… я, кажется, задремал{a}.', 'О, {player}! А у тебя нет чего-нибудь вкусненького, {phrase}?'] },
    { id: 'villagers:greet_night', topic: 'greet', when: { hours: [0, 5] }, lines: ['[sleepy] Ты чего не спишь, {phrase}? Я вот тоже…', '[thinking] Ночью остров совсем другой, {phrase}.'] },

    // --- small talk ---------------------------------------------------------------------------
    { id: 'villagers:chat', topic: 'chat', lines: [
      '[happy] Я вчера видел{a}, как {other} разговаривает с цветами. Это мило, {phrase}.',
      'Говорят, в музее появились новые экспонаты. Надо сходить, {phrase}!',
      '[happy] Лавка Тоши сегодня такая нарядная, {phrase}.',
      '[happy] Знаешь, что я люблю в нашем острове? Тишину, {phrase}.',
      'Если будешь в музее — передай привет Мире, {phrase}!',
    ] },
    { id: 'villagers:chat_summer', topic: 'chat', when: { seasons: ['summer'] }, lines: ['Летом море такое тёплое, {phrase}!', '[happy] Слышишь цикад? Значит, лето, {phrase}.'] },
    { id: 'villagers:chat_autumn', topic: 'chat', when: { seasons: ['autumn'] }, lines: ['[happy] Листья такие рыжие — прямо как шарфик, {phrase}.', '[thinking] Осенью щука клюёт, говорят. Не проверял{a}, {phrase}.'] },
    { id: 'villagers:chat_winter', topic: 'chat', when: { seasons: ['winter'] }, lines: ['[worried] Бр-р, холодно! Пойду домой греться, {phrase}.', '[happy] Снег скрипит под лапами — красота, {phrase}.'] },
    { id: 'villagers:chat_spring', topic: 'chat', when: { seasons: ['spring'] }, lines: ['Всё цветёт! У меня от этого настроение, {phrase}.', 'Весной на цветах так много бабочек, {phrase}!'] },
    { id: 'villagers:chat_rain', topic: 'chat', when: { weather: 'rain' }, lines: ['[surprised] В дождь на камни выползают улитки, {phrase}. Представляешь?'] },
    { id: 'villagers:chat_friend', topic: 'chat', when: { minHearts: 4 }, lines: [
      '[shy] Знаешь, с тобой на острове стало веселее, {phrase}.',
      '[happy] Если когда-нибудь тебе будет грустно — заходи ко мне, {phrase}.',
    ] },
    { id: 'villagers:chat_bookish', topic: 'chat', personality: 'villagers:bookish', lines: [
      '[thinking] А ты в курсе, что трилобиты жили задолго до динозавров, {phrase}?',
      'Я дочитал{a} третью книгу за неделю, {phrase}. Рекомендую!',
    ] },
    { id: 'villagers:chat_grumpy', topic: 'chat', personality: 'villagers:grumpy', lines: ['[angry] Все слишком шумные. Кроме тебя. Пока что, {phrase}.', '[happy] Окаменелости — вот это вещь. Не то что ваши цветочки, {phrase}.'] },
    { id: 'villagers:chat_sporty', topic: 'chat', personality: 'villagers:sporty', lines: ['Плавание! Бег! Рыбалка! В смысле… рыбалка — это тоже спорт, {phrase}!'] },
    { id: 'villagers:chat_dreamy', topic: 'chat', personality: 'villagers:dreamy', lines: ['[sleepy] Иногда я лежу у воды и считаю облака, {phrase}.', '[shy] Ракушки шепчут, если приложить к уху, {phrase}.'] },
    { id: 'villagers:chat_caring', topic: 'chat', personality: 'villagers:caring', lines: ['Ты хорошо кушаешь, {player}? Смотри у меня, {phrase}!', '[happy] Я полил{a} цветы у дорожки. Они так благодарно кивают, {phrase}.'] },
    { id: 'villagers:chat_cheerful', topic: 'chat', personality: 'villagers:cheerful', lines: ['[joy] Я поймал{a} бабочку и сразу отпустил{a}! Она такая красивая была, {phrase}!'] },

    // --- gifts --------------------------------------------------------------------------------
    { id: 'villagers:gift_love', topic: 'gift_love', lines: ['Ого! «{item}»! Это же то, что я люблю больше всего, {phrase}!', 'Мне?! «{item}»! Спасибо-спасибо, {phrase}!'] },
    { id: 'villagers:gift_like', topic: 'gift_like', lines: ['«{item}»? Как приятно, спасибо, {phrase}!', 'Ой, спасибо! Найду, куда поставить «{item}», {phrase}.'] },
    { id: 'villagers:gift_neutral', topic: 'gift_neutral', lines: ['[thinking] Хм, «{item}». Спасибо, {phrase}.', '«{item}»… Ну что ж, пригодится, {phrase}.'] },
    { id: 'villagers:gift_dislike', topic: 'gift_dislike', lines: ['[worried] «{item}»?.. Ну… спасибо, наверное, {phrase}.', '[worried] Э-э… Это мне? Ладно, {phrase}…'] },
    { id: 'villagers:gift_full', topic: 'gift_full', lines: ['Сегодня подарков уже достаточно! Оставь себе, {phrase}.'] },
    { id: 'villagers:gift_back', topic: 'gift_back', lines: ['Держи, это тебе в ответ, {phrase}! «{item}».', 'У меня для тебя тоже кое-что есть: «{item}», {phrase}!'] },
    { id: 'villagers:photo', topic: 'photo', lines: ['[shy] Ты мой лучший друг на острове. Вот, держи мою фотографию, {phrase}. На память!'] },
    { id: 'villagers:gift_favourite', topic: 'gift_favourite', lines: [
      '[love] «{item}»!!! Откуда ты знаешь, что это моё самое-самое любимое, {phrase}?!',
      '[joy] Не может быть… «{item}»! Я сейчас расплачусь от счастья, {phrase}!',
    ] },
    { id: 'villagers:gift_hated', topic: 'gift_hated', lines: [
      '[angry] «{item}»?! Только не это… Я же терпеть такое не могу, {phrase}!',
      '[worried] Ой… «{item}». Ты, наверное, не знаешь… Убери, пожалуйста, {phrase}.',
    ] },
    { id: 'villagers:hint_favourite', topic: 'hint_favourite', lines: [
      '[love] Скажу по секрету: больше всего на свете я люблю {fancy}, {phrase}.',
      '[shy] Знаешь, о чём я мечтаю? Чтобы кто-нибудь подарил мне {fancy}… {phrase}.',
    ] },
    { id: 'villagers:hint_hated', topic: 'hint_hated', lines: [
      '[worried] Только не дари мне {fancy}, ладно? Брр, {phrase}.',
      '[angry] Есть одна вещь, которую я не выношу: {fancy}. Вот так, {phrase}.',
    ] },

    // --- letters (no face tags on paper; {level} — what your friendship is called now) -----------
    { id: 'villagers:letter_thanks', topic: 'letter_thanks', lines: [
      'Привет, {player}!\n\nВсё никак не могу забыть твой подарок — «{item}». Поставил{a} на самое видное место и любуюсь. Спасибо тебе, {phrase}!',
      '{player}, здравствуй!\n\nПишу, чтобы ещё раз сказать спасибо за «{item}». Ты очень внимательный сосед. {phrase}!',
    ] },
    { id: 'villagers:letter_help', topic: 'letter_help', lines: [
      'Дорогой сосед!\n\nТвоя вчерашняя помощь пришлась как нельзя кстати: {item} — как раз то, что было нужно. Если что-то понадобится, обращайся, {phrase}!',
      'Привет!\n\nСпасибо за помощь. Без тебя я бы до сих пор искал{a} {item}. Ты настоящий друг, {phrase}.',
    ] },
    { id: 'villagers:letter_level_1', topic: 'letter_level', when: { maxHearts: 1 }, lines: [
      'Привет, {player}!\n\nЯ всё думаю о нашем знакомстве. Здорово, что мы соседи! Заглядывай поболтать, {phrase}.',
    ] },
    { id: 'villagers:letter_level_2', topic: 'letter_level', when: { minHearts: 2, maxHearts: 2 }, lines: [
      'Привет, {player}!\n\nМне кажется, мы стали настоящими приятелями. Заходи в гости, когда я дома, {phrase}!',
    ] },
    { id: 'villagers:letter_level_4', topic: 'letter_level', when: { minHearts: 3, maxHearts: 4 }, lines: [
      'Дорогой {player}!\n\nЯ тут подумал{a}: с тобой на острове стало гораздо уютнее. Ты для меня теперь {level}. Вот так, {phrase}.',
      '{player}!\n\nПросто хочу сказать, что очень рад{a} нашей дружбе. Ты {level}, честное слово, {phrase}!',
    ] },
    { id: 'villagers:letter_level_5', topic: 'letter_level', when: { minHearts: 5 }, lines: [
      'Мой дорогой {player}!\n\nТы — мой лучший друг. Даже не знаю, как жил{a} до того, как мы познакомились. Спасибо за всё, {phrase}.',
    ] },
    { id: 'villagers:letter_chat', topic: 'letter_chat', lines: [
      'Привет, {player}!\n\nНичего особенного, просто захотелось написать. Сегодня отличный день, правда? {phrase}!',
      'Здравствуй!\n\nВчера весь вечер смотрел{a} на море и думал{a} о том, как хорошо, что у меня есть такие соседи. {phrase}.',
    ] },
    { id: 'villagers:letter_chat_sleepy', topic: 'letter_chat', personality: 'villagers:sleepy', lines: [
      'При-ивет, {player}…\n\nМне приснилось, что весь остров — это большой пирог. Теперь всё утро хочется пирога… {phrase}.',
    ] },
    { id: 'villagers:letter_chat_sporty', topic: 'letter_chat', personality: 'villagers:sporty', lines: [
      'Йо, {player}!\n\nСегодня пробежал{a} десять кругов вокруг острова! Завтра — двенадцать. Присоединяйся, {phrase}!',
    ] },
    { id: 'villagers:letter_chat_elegant', topic: 'letter_chat', personality: 'villagers:elegant', lines: [
      'Дорогуша!\n\nЯ переставил{a} всю мебель дома, и теперь у меня настоящий салон. Приходи оценить, {phrase}.',
    ] },
    { id: 'villagers:letter_chat_dreamy', topic: 'letter_chat', personality: 'villagers:dreamy', lines: [
      '{player}…\n\nЕсли долго смотреть на облака, они начинают рассказывать сказки. Вчера одно облако было похоже на тебя. {phrase}.',
    ] },
    { id: 'villagers:letter_chat_cheerful', topic: 'letter_chat', personality: 'villagers:cheerful', lines: [
      'ПРИВЕТ, {player}!!!\n\nЯ сегодня поймал{a} стрекозу, и она СИДЕЛА У МЕНЯ НА НОСУ! Лучший день! {phrase}!',
    ] },
    { id: 'villagers:letter_chat_grumpy', topic: 'letter_chat', personality: 'villagers:grumpy', lines: [
      '{player}.\n\nПишу не от скуки, ясно? Просто бумага лишняя была. Хм. Заходи, если что. {phrase}.',
    ] },
    { id: 'villagers:letter_chat_caring', topic: 'letter_chat', personality: 'villagers:caring', lines: [
      'Милый {player}!\n\nНе забывай пить чай и ложиться вовремя. И надевай шарф, если ветрено! Обнимаю, {phrase}.',
    ] },
    { id: 'villagers:letter_chat_bookish', topic: 'letter_chat', personality: 'villagers:bookish', lines: [
      'Уважаемый {player}!\n\nЯ дочитал{a} книгу об окаменелостях. Оказывается, янтарю бывает сорок миллионов лет! Удивительно, {phrase}.',
    ] },
    { id: 'villagers:letter_farewell', topic: 'letter_farewell', lines: [
      'Дорогой {player}!\n\nЯ уже на новом острове. Здесь неплохо, но мне не хватает наших разговоров. Не забывай меня, {phrase}!',
      'Привет с нового места!\n\nСпасибо за всё, что было. Я буду вспоминать наш остров с теплом. Твой сосед {name}.',
    ] },
    { id: 'villagers:letter_ps', topic: 'letter_ps', lines: ['Кладу в конверт «{item}» — это тебе.', 'И ещё: в конверте «{item}». Пусть порадует!'] },

    // --- requests -----------------------------------------------------------------------------
    { id: 'villagers:request_ask', topic: 'request_ask', lines: ['Слушай, а можешь принести мне {request}? Я в долгу не останусь, {phrase}!', 'Мне бы {request}… Поможешь, {phrase}?'] },
    { id: 'villagers:request_waiting', topic: 'request_waiting', lines: ['[worried] Помнишь, я просил{a} {request}? Я всё ещё жду, {phrase}.'] },
    { id: 'villagers:request_none', topic: 'request_none', lines: ['У меня всё хорошо, спасибо, {phrase}!', '[happy] Да вроде ничего не нужно, {phrase}. Просто рад{a} поболтать.'] },
    { id: 'villagers:request_thanks', topic: 'request_thanks', lines: ['Ура, {item}! Ты лучший сосед, {phrase}! Вот, держи за помощь.', 'Это же {item}! Спасибо огромное, {phrase}!'] },

    // --- moving -------------------------------------------------------------------------------
    { id: 'villagers:leaving', topic: 'leaving', lines: ['[sad] Знаешь… я подумываю переехать на другой остров, {phrase}. Как думаешь?'] },
    { id: 'villagers:stay', topic: 'stay', lines: ['[joy] Правда? Ты хочешь, чтобы я остался{a}? Тогда остаюсь, {phrase}!'] },
    { id: 'villagers:farewell', topic: 'farewell', lines: ['Спасибо, что понимаешь. Буду скучать, {phrase}…'] },

    // --- said in passing, over the head ---------------------------------------------------------
    { id: 'villagers:hail', topic: 'hail', lines: ['Привет, {player}!', 'О, {player}! {phrase}!', 'Рад{a} встрече, {phrase}!'] },
    { id: 'villagers:hail_morning', topic: 'hail', when: { hours: [5, 11] }, lines: ['Доброе утро, {player}!', 'Уже на ногах? {phrase}!'] },
    { id: 'villagers:hail_evening', topic: 'hail', when: { hours: [18, 23] }, lines: ['Добрый вечер, {player}!', '[happy] Тихий вечер, {phrase}.'] },
    { id: 'villagers:hail_rain', topic: 'hail', when: { weather: 'rain' }, lines: ['Ну и дождик, {phrase}!', 'Не промокни, {player}!'] },
    { id: 'villagers:hail_friend', topic: 'hail', when: { minHearts: 3 }, lines: ['{player}! Как я рад{a}!', 'А я тебя искал{a}, {phrase}!'] },

    { id: 'villagers:bye', topic: 'bye', lines: ['Пока-пока, {phrase}!', 'Увидимся, {phrase}!', 'Заходи ещё, {phrase}!'] },
  ],
}
