      lines: {
        greet: ['А, покупатель! Я Бруно, хожу с острова на остров, хм-хм.', 'Здравствуй-здравствуй! Посмотри, что я сегодня привёз, хм-хм.'],
        chat: ['На соседнем острове яблоки с кулак! А у вас — с два кулака, хм-хм.', 'Я люблю ярмарки: все добрые и никто не торопится.'],
        thanks: ['Отличный выбор, хм-хм!', 'Береги, это вещь с историей!'],
        poor: ['Колокольчиков не хватает… Ничего, я ещё побуду тут, хм-хм.'],
        bye: ['До встречи на следующей ярмарке!', 'Счастливо, хм-хм!'],
      },
    },
    {
      id: 'events:pip', name: 'Пип', she: true, animal: 'пингвин', head: 'events:head_penguin', phrase: 'пип', voice: 520, speed: 0.024,
      colors: { s: '#3a3a48', S: '#fffaf0', t: '#e8645a', p: '#fffaf0', o: '#ffb34a' },
      lines: {
        greet: ['Привет-привет! Я Пип, пингвин, и я обожаю праздники, пип!', 'Ура, гости! Смотри, какие огоньки!'],
        chat: ['На моём айсберге всегда праздник, пип. Но у вас теплее.', 'Фонарики — это маленькие кусочки лета, пип!'],
        thanks: ['Пусть светит тебе долго-долго, пип!', 'Ура! Ещё что-нибудь?'],
        poor: ['Ой, колокольчиков маловато, пип…'],
        bye: ['Пока-пока, пип!', 'Увидимся на празднике!'],
      },
    },
  ],
