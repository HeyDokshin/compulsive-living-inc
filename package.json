{
  "name": "compulsive-living",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "mod": "node tools/mod.mjs",
    "app": "npm run build && node tools/desktop/build.mjs",
    "play": "npm run build && open dist/index.html",
    "format:check": "prettier --check .",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "json5": "^2.2.3",
    "miniplex": "^2.0.0",
    "preact": "^11.2.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.187.0",
    "tweakpane": "^4.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  }
}
