// Procedural 16×16 textures — soft pastel palette.
// Patterns: flat, noise, speckle, soft, grass_top, grass_side, strata, stone, planks, water
// (+ any added by plugins via api.textures.pattern).
// `material` (materials.json5) takes over close up — the pixel pattern stays for far views.
// Drop a PNG at content/core/textures/<name>.png to replace `core:<name>` with an image.
[
  { id: 'core:grass_top', pattern: 'grass_top', colors: ['#86c95e', '#a3db78', '#74b852'], params: { blades: 9 }, seed: 11, material: 'core:grass',
    variants: [{ material: 'core:clover', tint: '#a9d48c', share: 0.3 }, { material: 'core:meadow', tint: '#fbffd8', share: 0.22 }, { material: 'core:grass_dry', tint: '#ffe3a0', share: 0.22 }] },
  { id: 'core:grass_side', pattern: 'grass_side', colors: ['#c79a72', '#9bd67a'], params: { depth: 4, waves: 2 }, seed: 12, material: 'core:cliff' },
  { id: 'core:dirt', pattern: 'soft', colors: ['#c79a72', '#b5875f', '#d6ab84'], params: { dots: 7 }, seed: 13, material: 'core:dirt' },
  { id: 'core:sand', pattern: 'soft', colors: ['#f8ebc4', '#efdcab', '#fff6dc', '#f2c9b8'], params: { dots: 8, amount: 0.03 }, seed: 14, material: 'core:sand', variants: [{ material: 'core:sand_shells', tint: '#f6ead8', share: 0.3 }] },
  { id: 'core:cliff', pattern: 'strata', colors: ['#c49a76', '#b38865', '#cfa883', '#ba9070'], params: { band: 4 }, seed: 15, material: 'core:cliff' },
  { id: 'core:stone', pattern: 'soft', colors: ['#b9bcc6', '#a9adb8', '#c9ccd4'], params: { dots: 6 }, seed: 16, material: 'core:stone', variants: [{ material: 'core:moss', tint: '#cfe0b4', share: 0.25 }] },
  { id: 'core:planks', pattern: 'planks', colors: ['#e2b27f'], params: { boards: 4 }, seed: 18, material: 'core:planks' },
  { id: 'core:water', pattern: 'water', colors: ['#7fd8ec', '#c9f3fb'], params: { ripples: 4 }, seed: 17 },
]
