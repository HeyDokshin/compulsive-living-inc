// Core blocks. `textures` point to entries in textures.json5 (or PNGs in content/core/textures/).
// Without `textures`, a block gets an automatic noise texture from `color`.
// Tags let mechanics refer to groups ("#core:ground") instead of concrete ids.
{
  entries: [
    {
      id: 'core:grass', name: 'Трава', color: '#9bd67a',
      textures: { top: 'core:grass_top', side: 'core:grass_side', bottom: 'core:dirt' },
      tint: true,
      tags: ['core:ground', 'core:diggable', 'core:flora_soil'],
    },
    { id: 'core:dirt', name: 'Земля', color: '#c79a72', textures: { all: 'core:dirt' }, tags: ['core:ground', 'core:diggable'] },
    { id: 'core:sand', name: 'Песок', color: '#f8ebc4', textures: { all: 'core:sand' }, tags: ['core:ground', 'core:diggable'] },
    { id: 'core:cliff', name: 'Скала', color: '#c49a76', textures: { all: 'core:cliff' }, tags: ['core:ground'] },
    { id: 'core:stone', name: 'Камень', color: '#b9bcc6', textures: { all: 'core:stone' }, tags: ['core:ground'] },
    { id: 'core:planks', name: 'Доски', color: '#e2b27f', textures: { all: 'core:planks' }, tags: ['core:wood'] },
    {
      id: 'core:water', name: 'Вода', color: '#7fd8ec', textures: { all: 'core:water' },
      solid: false, transparent: true, liquid: true, tags: ['core:liquid'],
    },
  ],
}
