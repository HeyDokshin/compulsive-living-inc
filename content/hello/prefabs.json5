// Prefabs = named bundles of components. `extends` inherits and deep-merges.
[
  {
    id: 'hello:crate',
    components: {
      name: 'Ящик',
      transform: { x: 0, y: 1, z: 0 },
      model: { size: [0.8, 0.8, 0.8], color: '#c98b4f' },
    },
  },
  {
    id: 'hello:spinner',
    extends: 'hello:crate',
    tags: ['hello:toys'],
    components: {
      name: 'Крутилка',
      model: { size: [0.6, 1.2, 0.6], color: '#f2a6c8' },
      spin: { speed: 1, bob: 0.15 },
    },
  },
]
