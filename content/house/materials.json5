// Surfaces of the house inside (rooms kit): wallpapers, panelling, floors, trims. Light colors —
// finishes tint them (content/house/house.finishes.json5: `look.color`).
[
  {
    // plain paper: soft fibres and a faint print of little dots
    id: 'house:paper_dots',
    shading: 0.5,
    occlusion: 0.2,
    layers: [
      { kind: 'noise', colors: ['#f2ede6', '#fbf8f3'], scale: 3, octaves: 4, relief: 0.15, seed: 201 },
