// What the curator (Мира, a capybara) says. A topic has several lines; one is picked at random.
// {name}, {description}, {count}, {total} are filled in by the museum plugin.
{
  entries: [
    { id: 'museum:greet_first', lines: ['Ой, здравствуйте! Я Мира — капибара и, с сегодняшнего дня, смотрительница этого музея. Приносите рыб, насекомых и окаменелости, а я найду им место в зале.'] },
    { id: 'museum:greet', lines: [
      'Добро пожаловать в музей! Тише-тише… экспонаты любят покой.',
      'О, это вы! Рада вас видеть. Принесли что-нибудь интересное?',
      'Здравствуйте! Я как раз протирала витрины.',
      'Ах, гость! Музей без гостей — просто очень тихий дом.',
    ] },
    { id: 'museum:pick', lines: ['Что вы хотите подарить музею?', 'Покажите, что у вас есть!'] },
    { id: 'museum:nothing', lines: [
      'Хм… в ваших карманах нет ничего нового для музея. Но я терпеливая!',
      'Пока подарить нечего — всё это у нас уже есть. Ловите, копайте, и возвращайтесь!',
    ] },
    { id: 'museum:thanks', lines: [
      'Чудесно! «{name}» займёт своё место в зале. {description}',
      'Ах, «{name}»! Какая находка. {description}',
      'Спасибо! Я сразу поставлю «{name}» в витрину. {description}',
    ] },
    { id: 'museum:assess', lines: ['Так-так, посмотрим поближе… Это {name}! {description}', 'Ох, да это же {name}! {description}'] },
    { id: 'museum:assess_dup', lines: ['Такой экспонат у нас уже есть — оставьте его себе или продайте.'] },
    { id: 'museum:progress', lines: ['В музее уже {count} из {total} экспонатов. Залы потихоньку оживают!'] },
    { id: 'museum:hint_new', lines: [
      'Говорят, сейчас на острове можно встретить кого-то, кого ещё нет в нашей коллекции…',
      'Я слышала, в это время года на острове появляются новые обитатели. Может, заглянете к воде или к цветам?',
    ] },
    { id: 'museum:hint_none', lines: ['Кажется, всё, что сейчас водится на острове, у нас уже есть. Загляните в другое время дня или года!'] },
    { id: 'museum:complete', lines: ['Вы собрали всё-всё! Я… кажется, сейчас расплачусь от счастья.'] },
    { id: 'museum:bye', lines: ['Заходите ещё!', 'Берегите себя и сачок!', 'До встречи! Я буду здесь, среди витрин.'] },
  ],
}
