  { id: 'nature:peach', name: 'Персик', fruitItem: 'core:peach', fruitModel: 'nature:fruit_peach', sapling: 'nature:sapling_peach' },
  { id: 'nature:orange', name: 'Апельсин', fruitItem: 'core:orange', fruitModel: 'nature:fruit_orange', sapling: 'nature:sapling_orange' },
  { id: 'nature:oak', name: 'Дуб', sapling: 'nature:sapling_oak',
    seasons: {
      autumn: { l: '#e8b04e', d: '#c98a3a', h: '#f2d27a' },
    } },
]
